<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MoonChat.Client.App"
             RequestedThemeVariant="Dark">

  <!-- ===================== resources ===================== -->
  <Application.Resources>
    <ResourceDictionary>
      <SolidColorBrush x:Key="SurfaceBrush" Color="#11141C" />
      <SolidColorBrush x:Key="ElevatedBrush" Color="#171B26" />
      <SolidColorBrush x:Key="InputBrush" Color="#1E2331" />
      <SolidColorBrush x:Key="BorderBrush" Color="#262C3B" />
      <SolidColorBrush x:Key="AccentBrush" Color="#5B8DEF" />
      <SolidColorBrush x:Key="AccentStrongBrush" Color="#4A7AE0" />
      <SolidColorBrush x:Key="DangerBrush" Color="#E2725B" />
      <SolidColorBrush x:Key="OnlineBrush" Color="#3FB8A0" />
      <SolidColorBrush x:Key="WarningBrush" Color="#D9A441" />
      <SolidColorBrush x:Key="MutedBrush" Color="#8B93A7" />
      <SolidColorBrush x:Key="TextBrush" Color="#E6E9F0" />
      <SolidColorBrush x:Key="BubbleBrush" Color="#1E2331" />
    </ResourceDictionary>
  </Application.Resources>

  <!--
    Plain setters only: Avalonia's own Fluent templates do the rendering.
    Custom ControlThemes are kept out of this until it is clear the defaults
    are not enough.
  -->
  <Application.Styles>
    <FluentTheme />

    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontSize" Value="14" />
    </Style>

    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style Selector="Ellipse">
      <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
    </Style>

    <Style Selector="Ellipse.online">
      <Setter Property="Fill" Value="{StaticResource OnlineBrush}" />
    </Style>

    <Style Selector="Ellipse.connecting">
      <Setter Property="Fill" Value="{StaticResource WarningBrush}" />
    </Style>

    <!-- buttons -->
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Padding" Value="16,11" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource AccentStrongBrush}" />
    </Style>

    <Style Selector="Button.primary.slim">
      <Setter Property="Padding" Value="14,8" />
      <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Button.link">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style Selector="Button.icon">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="7" />
    </Style>

    <Style Selector="Button.tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="CornerRadius" Value="9" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.tab:pointerover">
      <Setter Property="Background" Value="{StaticResource InputBrush}" />
    </Style>

    <Style Selector="Button.tab.active">
      <Setter Property="Background" Value="{StaticResource InputBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- inputs -->
    <Style Selector="TextBox">
      <Setter Property="Background" Value="{StaticResource InputBrush}" />
      <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="12,10" />
      <Setter Property="CaretBrush" Value="{StaticResource TextBrush}" />
    </Style>

    <Style Selector="TextBox:pointerover /template/ ContentPresenter">
      <Setter Property="TextBlock.Foreground" Value="{StaticResource TextBrush}" />
    </Style>

    <!-- lists: keep the stock item template, just drop the chrome -->
    <Style Selector="ListBox.plain">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>

    <!--
      Conversation and contact rows are Buttons in an ItemsControl rather than
      selectable ListBox rows: that avoids Fluent's selection fill entirely and
      makes the click target the whole row.
    -->
    <Style Selector="Button.rowsex">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Padding" Value="10,9" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.rowsex:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{StaticResource InputBrush}" />
      <Setter Property="CornerRadius" Value="11" />
    </Style>

    <Style Selector="Button.rowsex.selected">
      <Setter Property="Background" Value="#2C3A55" />
    </Style>

    <!--
      Rows draw their own highlight, so Fluent's selection fill (a bright
      accent) is turned off. ControlTheme setters outrank application styles,
      so the template part has to be targeted directly.
    -->
    <Style Selector="ListBoxItem:selected">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBoxItem:selected /template/ Border#PART_SelectionBackground">
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBoxItem:pointerover /template/ Border#PART_SelectionBackground">
      <Setter Property="Background" Value="{StaticResource InputBrush}" />
    </Style>

    <!-- surfaces -->
    <Style Selector="Border.card">
      <Setter Property="Background" Value="{StaticResource ElevatedBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="16" />
    </Style>

    <Style Selector="Border.row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="CornerRadius" Value="11" />
      <Setter Property="Padding" Value="10,9" />
    </Style>

    <Style Selector="Border.row:pointerover">
      <Setter Property="Background" Value="{StaticResource InputBrush}" />
    </Style>

    <Style Selector="Border.row.selected">
      <Setter Property="Background" Value="#2C3A55" />
    </Style>

    <Style Selector="Border.bubble">
      <Setter Property="Background" Value="{StaticResource BubbleBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="10,8" />
    </Style>

    <Style Selector="Border.bubble.mine">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
    </Style>

    <Style Selector="Border.bubble.pending">
      <Setter Property="Opacity" Value="0.65" />
    </Style>

    <Style Selector="Border.pill">
      <Setter Property="Background" Value="{StaticResource AccentBrush}" />
      <Setter Property="CornerRadius" Value="999" />
      <Setter Property="Padding" Value="7,1" />
    </Style>
  </Application.Styles>
</Application>