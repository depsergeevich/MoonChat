<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Project-local feed list. This intentionally clears inherited sources: a
    machine-wide config on some setups still lists nuget.org over plain HTTP,
    which modern NuGet refuses (NU1302). Declaring the HTTPS feed here keeps
    restore working regardless of what is configured globally.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <disabledPackageSources>
    <clear />
  </disabledPackageSources>
</configuration>