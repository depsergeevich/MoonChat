<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A library, not an app: Microsoft.NET.Test.Sdk supplies the entry point
         when "dotnet test" or vstest loads it. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MoonChat.Client.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- The referenced client is a WinExe with an app manifest; none of that
         matters here, but keep the flags aligned so behaviour matches the app. -->
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\MoonChat.Client.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The test project supplies its own NuGet.config-free setup; it inherits
         ../../NuGet.config by directory walk-up, which is what keeps restore
         working on machines with a broken global feed list. -->
    <Using Include="Xunit" />
  </ItemGroup>

</Project>